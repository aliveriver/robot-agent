# ============================================================
# Robot Agent — 环境变量模板
# 复制此文件为 .env 并填写真实值，.env 不要提交到 git
# ============================================================

# ── LLM API ──────────────────────────────────────────────────
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL_NAME=gpt-4o
LLM_MULTIMODAL_MODEL_NAME=gpt-4o

# ── TTS (Kokoro WebSocket) ────────────────────────────────────
KOKORO_WS_URL=ws://127.0.0.1:7860/ws_rvc_tts
KOKORO_DEFAULT_VOICE=zh_spongebob
KOKORO_SPEED=1.0

# ── ASR (Sherpa-ONNX) ────────────────────────────────────────
SHERPA_MODEL_DIR=/path/to/sherpa/models
SHERPA_TOKENS_PATH=/path/to/tokens.txt

# ── Audio Device ─────────────────────────────────────────────
# 留空则自动选择系统默认设备
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_INPUT_GAIN=0.35
AUDIO_NOISE_FLOOR=0.01
AUDIO_SPEECH_THRESHOLD=0.03
AUDIO_MAX_SILENCE_SEC=0.45
AUDIO_MAX_SEGMENT_SEC=8.0
AUDIO_MIN_SEGMENT_SEC=0.3

# ── Database ─────────────────────────────────────────────────
SQLITE_PATH=data/robot.db

# ── Vector Store (Chroma) ────────────────────────────────────
CHROMA_PERSIST_DIR=data/chroma

# ── Application ──────────────────────────────────────────────
APP_LANG=cn
APP_LOG_LEVEL=INFO
APP_ENV=development
