# ============================================================
# Robot Agent - .env.example（模板，复制为 .env 后填入真实值）
#
# 职责：只存放【密钥】和【机器/部署特定的覆盖值】。
# 其余所有配置请在 configs/app.yaml 中修改。
#
# 配置优先级：环境变量 > .env > configs/app.yaml
# ============================================================

# —— LLM API 密钥（必填）———————————————————————————————————
LLM_API_KEY=your-llm-api-key

# —— TTS API 密钥（必填）———————————————————————————————————
TTS_API_KEY=your-minimax-api-key

# —— 音频设备（机器特定，留空使用系统默认）——————————————
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# —— 猜拳视觉判定（OpenAI-compatible Vision API）——————————
GAME_VISION_API_URL=https://api.sudorelay.com/v1/chat/completions
GAME_VISION_API_KEY=sk-lbuMchwc9EvIkN29DEXRZPJjTDhUD8CLiu40Gp4Bcu7fNrYI
GAME_VISION_MODEL=gpt-6-luna
# 猜拳双臂轨迹：script/trajectory_manager/data/trajectories.db 中的 ID
# 当前默认 ID 5（12314545，1658 帧）；ID 6 为 1243124，ID 2 为 123123。
GAME_TRAJECTORY_ID=5
# 独立猜拳 Demo 相机参数（无需 configs/app.yaml）
VISION_CAMERA_TOPIC=/camera/color/image_raw
VISION_CAPTURE_TIMEOUT=2.0
VISION_PREFER_ROS=true
VISION_LOCAL_DEVICE_INDEX=0
# 独立 play_game.py 默认自动启动并退出 Orbbec Gemini 330 驱动。
GAME_CAMERA_AUTO_START=true
GAME_CAMERA_LAUNCH_COMMAND=source install/setup.bash && ros2 launch orbbec_camera gemini_330_series.launch.py
GAME_CAMERA_LAUNCH_CWD=/home/nvidia/orbbec_camera_ros2
GAME_CAMERA_STARTUP_DELAY_SEC=3.0
# 本地「石头、剪刀、布」完整口令音频，相对 robot-agent 根目录；填好后启用。
GAME_COUNTDOWN_AUDIO=
# 示例：GAME_COUNTDOWN_AUDIO=data/audio/rock_paper_scissors.wav
# 保留原准备停顿；口令在轨迹末段播放完毕后再出最终手势。
GAME_READY_DELAY_SEC=3.0
GAME_REVEAL_DELAY_SEC=0.0
GAME_RESULT_WAIT_SEC=2.0
# 未提供音频时，模拟口令的估计时长；提供音频后使用文件真实时长。
GAME_COUNTDOWN_DURATION_SEC=1.5
# 扬声器存在延迟时，可让口令提前该秒数启动。
GAME_AUDIO_LEAD_SEC=0.0

# —— LangSmith 追踪（可选）——————————————————————————————
# 在 https://smith.langchain.com 注册后获取 API Key，取消注释即可开启
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_your_key_here
# LANGSMITH_PROJECT=robot-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Game speech presets from the local TTS library.
GAME_AUDIO_DB=data/tts_audio.sqlite3
GAME_AUDIO_DIR=data/tts_audio
GAME_COUNTDOWN_PRESET=石头剪刀布
GAME_PLAYER_WIN_PRESET=你赢了
GAME_ROBOT_WIN_PRESET=我赢了
# Last camera frame sent to vision, encoded as PNG.
GAME_CAPTURE_IMAGE_PATH=script/temp.png
