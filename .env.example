# ============================================================
# Robot Agent - 环境变量模板
# 只保留必须由环境变量提供或可被环境覆盖的配置项
# ============================================================

# —— LLM API ——————————————————————————————————————————————
LLM_API_URL=https://XXX/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o
LLM_MULTIMODAL_MODEL=gpt-4o

# —— TTS (Minimax WebSocket) ———————————————————————————
TTS_PROVIDER=minimax
TTS_API_URL=https://api.XXX.com/v1/t2a_v2
TTS_WS_URL=wss://api.XXX.com/ws/v1/t2a_v2
TTS_API_KEY=your-minimax-api-key
TTS_MODEL=XXX
TTS_DEFAULT_VOICE=XXX
TTS_SPEED=1.0

# ── ASR (Sherpa-ONNX) ────────────────────────────────────────
SHERPA_MODEL_DIR=/path/to/sherpa/models
SHERPA_TOKENS_PATH=/path/to/tokens.txt

# —— Audio Device ——————————————————————————————————————
# 留空则自动选择系统默认设备
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_INPUT_GAIN=0.35
AUDIO_NOISE_FLOOR=0.01
AUDIO_SPEECH_THRESHOLD=0.03
AUDIO_MAX_SILENCE_SEC=0.45
AUDIO_MAX_SEGMENT_SEC=8.0
AUDIO_MIN_SEGMENT_SEC=0.3

# —— Database ——————————————————————————————————————————
SQLITE_PATH=data/robot.db
CHROMA_PERSIST_DIR=data/chroma

# —— Application ———————————————————————————————————————
APP_LANG=cn
APP_LOG_LEVEL=INFO
APP_ENV=development

# —— Vision / Camera ——————————————————————————————————
VISION_CAMERA_TOPIC=/camera/color/image_raw
VISION_CAPTURE_TIMEOUT=2.0
VISION_SAVE_DIR=data/camera
VISION_LOCAL_DEVICE_INDEX=0
VISION_PREFER_ROS=true

# —— Voice Clone ———————————————————————————————————————
VOICE_CLONE_BASE_URL=XXX
