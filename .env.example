# ============================================================
# Robot Agent - .env.example（模板，复制为 .env 后填入真实值）
#
# 职责：只存放【密钥】和【机器/部署特定的覆盖值】。
# 其余所有配置请在 configs/app.yaml 中修改。
#
# 配置优先级：环境变量 > .env > configs/app.yaml
# ============================================================

# —— LLM API 密钥（必填）———————————————————————————————————
LLM_API_KEY=your-llm-api-key

# —— TTS API 密钥（必填）———————————————————————————————————
TTS_API_KEY=your-minimax-api-key

# —— 音频设备（机器特定，留空使用系统默认）——————————————
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
